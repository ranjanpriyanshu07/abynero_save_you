<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used to send a link the user chose to check to Google Safe Browsing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        Android 11 and below only reveal a Wi-Fi network's security type to apps with location
        access. It is requested with an explanation, only on those versions, and never used to
        track the user. Android 12+ does not need it.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- QR code scanning. Requested only when the user opens the QR scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Alerts about new risky apps (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the "Uninstall" button open the system uninstall dialog. The user always confirms. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        QUERY_ALL_PACKAGES justification (Google Play "permitted use: device security"):
        PhoneGuard is an on-device security scanner. Its core feature is to inspect every
        user-installed app for risky permissions, sideloading and known remote-control
        (screen-sharing scam) apps. This cannot be done with targeted <queries>, because the
        apps to check are, by definition, unknown in advance. The app inventory is processed
        only on the device and is never transmitted off the device.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- READ_SMS and call-log permissions are intentionally NOT used (restricted by Play policy).
         Users paste or share suspicious messages into the app instead. -->

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".PhoneGuardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneGuard"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PhoneGuard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share" a suspicious SMS or link to PhoneGuard to check it. -->
            <intent-filter android:label="@string/tool_message_title">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- WorkManager is initialised by PhoneGuardApplication so Hilt can inject workers. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
